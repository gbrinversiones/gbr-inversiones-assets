ones", "link": "https://www.lanacion.com.ar/economia/campo/perspectivas-favorables-cresud-el-brazo-agropecuario-de-irsa-sembrara-324000-hectareas-un-33-mas-nid11112026/", "fuente": "La Nación - Economía"}, {"tipo_evento": "noticia", "ticker": "YPFD.BA", "empresa": "YPF", "fecha": "2026-11-12", "titulo": "Vaca Muerta récord: con YPF como líder, superó en diez meses las fracturas de todo 2025", "detalle": "Publicado hoy a las 14:55", "resumen": "La actividad no convencional en Argentina alcanzó las 24.028 etapas de fractura entre enero y octubre de 2026, por encima de las 23.894 registradas durante todo el año pasado. YPF concentró casi la mitad de las operaciones, seguida por Vista y Pluspetrol.", "link": "https://www.bloomberglinea.com/economia/vaca-muerta-record-con-ypf-como-lider-supero-en-diez-meses-las-fracturas-de-todo-2025/", "fuente": "Bloomberg Línea - Economía"}], "macro": {"actualizado": "2026-11-12T20:04:21.826680+00:00", "indec": {}, "bcra": {"rem": {"fecha": "2026-10-31", "inflacion_12m": 21.8}, "tasas": {"fecha": "2026-11-05", "badlar": 22.5, "tamar": 24.125}, "uva": {"fecha": "2026-11-12", "valor": 2193.45, "var_anual": 33.32826793909369}, "dinero": {"fecha": "2026-11-04", "base_millones": 46845363.0, "base_var_anual": 15.011731989607991, "m2_fecha": "2026-11-10", "m2_var_interanual": 23.2}}}}