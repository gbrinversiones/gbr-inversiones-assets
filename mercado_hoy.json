as": [{"titulo": "Saudi Arabia postpones big investor conference to 2027 as Iran-backed Houthis escalate attacks on kingdom", "link": "https://www.cnbc.com/2026/10/19/saudi-arabia-postpones-fii-investor-conference-to-2027.html", "fuente": "CNBC - World News", "hora": "13:30"}, {"titulo": "Ciudadanía por inversión: qué atrae a los extranjeros y qué cuestionan los especialistas", "link": "https://www.cronista.com/economia-politica/ciudadania-por-inversion-que-atrae-a-los-extranjeros-y-que-cuestionan-los-especialistas/", "fuente": "El Cronista - Economía y Política", "hora": "13:28"}, {"titulo": "\"Protestas en Francia el 17 de octubre: anatomía de un fiasco\": 'Liberation'", "link": "https://www.france24.com/es/programas/revista-de-prensa/20261019-protestas-en-francia-el-17-de-octubre-anatom%C3%ADa-de-un-fiasco-liberation", "fuente": "France 24 - Español", "hora": "13:20"}, {"titulo": "El Gobierno prorrogó el régimen que permite a 50.000 trabajadores rurales el cobro de planes sociales", "link": "https://www.infobae.com/economia/2026/10/19/el-gobierno-prorrogo-el-regimen-que-permite-a-120000-trabajadores-rurales-el-cobro-de-planes-sociales/", "fuente": "Infobae - Economía", "hora": "13:17"}, {"titulo": "Obama blasts Trump administration probe of congresswoman Ilhan Omar as 'so appalling'", "link": "https://www.bbc.co.uk/news/articles/cr15jl7dd42vo?at_medium=RSS&at_campaign=rss", "fuente": "BBC - World News", "hora": "13:16"}, {"titulo": "El Gobierno analiza postergar el inicio del FAL, el fondo para pagar indemnizaciones laborales", "link": "https://www.infobae.com/economia/2026/10/19/el-gobierno-analiza-postergar-el-inicio-del-fal-el-fondo-para-pagar-indemnizaciones-laborales/", "fuente": "Infobae - Economía", "hora": "13:15"}, {"titulo": "Balotaje de las Elecciones Brasil 2026, EN VIVO: las últimas noticias sobre los comicios hoy", "link": "https://www.lanacion.com.ar/el-mundo/balotaje-de-las-elecciones-brasil-2026-en-vivo-las-ultimas-noticias-sobre-los-comicios-hoy-nid19102026/", "fuente": "La Nación - El Mundo", "hora": "13:15"}, {"titulo": "Las acciones argentinas operan en baja mientras Wall Street rebota gracias a las tecnológicas", "link": "https://www.infobae.com/economia/2026/10/19/las-acciones-argentinas-operan-en-baja-mientras-wall-street-rebota-gracias-a-las-tecnologicas/", "fuente": "Infobae - Economía", "hora": "13:09"}, {"titulo": "Spain stocks lower at close of trade; IBEX 35 down 1.49%", "link": "https://www.investing.com/news/stock-market-news/spain-stocks-lower-at-close-of-trade-ibex-35-down-149-4958063", "fuente": "Investing.com - Stock Markets News", "hora": "13:09"}, {"titulo": "S&P 500 rises and Nasdaq jumps 1.5%, rebounding after their worst week since June", "link": "https://www.investing.com/news/stock-market-news/us-stock-futures-climb-as-investors-return-to-ai-trade-after-selloff-4956195", "fuente": "Investing.com - Stock Markets News", "hora": "13:08"}], "analisis": {"disponible": true, "formato": "vinietas", "internacional": "- Los mercados globales se mueven de forma mixta: el **S&P 500** subió **0,4%** hasta **7.694 puntos**, mientras que el **Euro Stoxx 50** cayó **1,3%** y el **Nikkei 225** retrocedió **0,6%**.\n- Las protestas en Francia impulsaron ventas de bonos franceses y presionaron al euro, con caídas también en la bolsa de París.\n- El **petróleo WTI** bajó **3,9%** a **$97,48** después de que Estados Unidos suspendiera nuevos aranceles a bienes rusos, lo que abre la expectativa de más oferta de crudo.\n- Las tasas de los bonos del Tesoro de Estados Unidos llegaron a **máximos de dos décadas**, lo que encarece el crédito en todo el mundo y pesa sobre países como la Argentina.\n- El **VIX** cayó **9,7%** hasta **18,1**, señal de menor nerviosismo, y el **Bitcoin** se acercó a los **u$s83.000** con más apetito por activos de riesgo.\n- Las acciones de inteligencia artificial rebotaron tras la peor semana desde junio, y **Micron** y otras empresas de chips se recuperaron de una fuerte caída.\n- Una empresa muy apostada al boom de la IA generó alertas en Wall Street por una deuda acumulada de **u$s50.000 millones**.", "nacional": "- El mercado argentino cerró con leve baja: el **Merval** retrocedió **0,4%** hasta **2.848.945 puntos**, mientras el **dólar oficial** quedó en **$1.535**, el **MEP** en **$1.542** y el **CCL** en **$1.620**, sin variaciones en el día.\n- El **riesgo país** subió **4,2%** y llegó a **648 puntos**, en un contexto de caída de los bonos en dólares y mayor aversión al riesgo.\n- Entre las acciones, **Grupo Financiero Galicia (GGAL)** subió **1,0%** y **Banco de Valores (VALO)** avanzó **0,8%**, mientras que **Mercadolibre Inc. (MELI)** tuvo una suba de **0,2%** y **YPF (YPFD)** no registró cambios.\n- Entre los bonos soberanos, el **GD46** cayó **1,6%**, el **GD38** bajó **0,7%** y el **AN29** retrocedió **0,6%**.", "politica_arg": "- El **riesgo país** subió **4,2%** hasta **648 puntos** y el mercado sigue atento a la situación política y económica local, mientras el **dólar oficial** se mantuvo en **$1.535**.\n- Las **reservas del BCRA** llegaron a **49.723 millones de USD**, con una compra neta de **291 millones de USD** en la última rueda.\n- La inflación mensual de septiembre fue de **1,9%**, y la tasa del **plazo fijo** para octubre es de **22,4% TNA**, por lo que el plazo fijo **pierde** contra la inflación en términos reales (**0,06%**).\n- El jefe de Gabinete **Diego Santilli** respaldó la reforma electoral y la suspensión o eliminación de las PASO, aunque el Gobierno no logra avanzar en el Congreso y mira hacia sesiones extraordinarias.", "politica_internacional": "- El presidente de **Estados Unidos**, **Donald Trump**, suspendió nuevos aranceles sobre bienes rusos y a grandes compradores de energía rusa, usando una excepción por interés nacional de la **Ley Graham**.\n- Esa decisión generó expectativas de mayor oferta de petróleo y hizo caer los precios del crudo durante el día.\n- La economía de **China** mostró un crecimiento superior a lo previsto, pero enfrenta desequilibrios internos que preocupan a los analistas.", "profundiza_internacional": {"link": "https://www.ambito.com/finanzas/las-protestas-francia-aceleran-la-ola-venta-bonos-y-le-suman-presion-al-euro-n6335232", "fuente": "Ámbito - Finanzas"}, "profundiza_nacional": {"link": "https://www.ambito.com/finanzas/el-dolar-mayorista-se-ubica-arriba-1530-y-el-bcra-busca-acelerar-la-compra-reservas-n6335172", "fuente": "Ámbito - Finanzas"}, "profundiza_politica_arg": {"link": "https://www.ambito.com/politica/causa-del-oro-pidieron-allanar-el-bcra-e-investigar-posibles-comisiones-millonarias-n6335250", "fuente": "Ámbito - Política"}, "profundiza_politica_internacional": {"link": "https://www.ambito.com/economia/la-china-crecio-45-el-tercer-trimestre-y-supero-las-proyecciones-del-mercado-n6335189", "fuente": "Ámbito - Economía"}, "generado": "2026-10-19T13:52:09.479000+00:00"}, "bonos": {"instrumento": "bonos_soberanos", "puntos": [{"ticker": "AO27", "ley": "Argentina", "plazo_años": 1.027, "tir_%": 2.966, "nombre": "Bono Tesoro Nacional USD 6% 2027 (mensual)", "precio_actual": 103.45, "valor_tecnico": 100.333, "v_residual_%": 100.0, "interes_corrido": 0.333, "paridad_%": 103.11, "estado_paridad": "sobre_la_par", "duration_años": 0.994, "duration_modificada_años": 0.965, "fecha_vencimiento": "2027-10-29", "tasa_cupon_%": 6.0, "fecha_inicio_periodo": "2026-09-30", "byma_isin": "AR0676997536", "byma_sector": "Estado Nacional", "byma_fecha_emision": "2026-02-27", "byma_monto_emitido": 1445370497.0, "byma_moneda_emision": "USD", "byma_tipo_tasa": "Tasa Fija", "byma_frecuencia_cupon": "Mensual", "byma_proximo_cupon": "2026-10-30", "byma_cupon_actual_%": 6.0, "byma_variacion_tir_pb": 10.8, "byma_tir_byma_%": 2.6768, "byma_duration_mod_byma": 0.9705, "byma_fecha": "2026-10-16"}, {"ticker": "AO28", "ley": "Argentina", "plazo_años": 2.036, "tir_%": 10.706, "nombre": "Bono Tesoro Nacional USD 6% 2028 (mensual)", "precio_actual": 92.6